default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to Apple TestFlight automatically"
  lane :beta do
    # 1. Setup CI (Creates temporary keychain, installs Apple WWDR certificates)
    setup_ci

    # 2. Install Manual Certificate & Profile
    import_certificate(
      certificate_path: File.expand_path("../certs/ios_distribution.p12", __dir__),
      certificate_password: "Apple123!",
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # Forcefully allow codesign to access the private key
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k \"\" ~/Library/Keychains/fastlane_tmp_keychain-db")

    install_provisioning_profile(
      path: File.expand_path("../certs/EtasEt_AppStore_Profile.mobileprovision", __dir__)
    )

    # 3. Build IPA
    build_app(
      project: File.expand_path("../dars-ios.xcodeproj", __dir__),
      scheme: "dars-ios",
      export_method: "app-store",
      clean: true,
      output_name: "dars-ios.ipa",
      xcargs: "OTHER_CODE_SIGN_FLAGS=\"--keychain ~/Library/Keychains/fastlane_tmp_keychain-db\" CURRENT_PROJECT_VERSION=#{ENV['GITHUB_RUN_NUMBER'] || '100'}",
      export_options: {
        signingStyle: "manual",
        teamID: "WGARWL7QZ4",
        provisioningProfiles: {
          "com.amasyaetas.mobile" => "EtasEt_AppStore_Profile"
        }
      }
    )

    # 4. Upload to Apple TestFlight via Transporter (Uses App-Specific Password, no REST API token or 2FA required)
    ipa_path = File.expand_path("../dars-ios.ipa", __dir__)
    xcode_path = `xcode-select -p`.strip
    transporter_candidates = [
      "#{xcode_path}/../SharedFrameworks/ContentDeliveryServices.framework/Versions/A/itms/bin/iTMSTransporter",
      "/Applications/Xcode_16.1.app/Contents/SharedFrameworks/ContentDeliveryServices.framework/Versions/A/itms/bin/iTMSTransporter",
      "iTMSTransporter"
    ]
    transporter_bin = transporter_candidates.find { |p| File.exist?(p) } || "iTMSTransporter"

    UI.message("Uploading #{ipa_path} to TestFlight using #{transporter_bin}...")
    sh("\"#{transporter_bin}\" -m upload -u \"#{ENV['FASTLANE_USER']}\" -p \"#{ENV['FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD']}\" -assetFile \"#{ipa_path}\" -v detailed")
  end
end
