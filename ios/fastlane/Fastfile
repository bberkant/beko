default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to Apple TestFlight automatically"
  lane :beta do
    # 1. Setup CI (Creates temporary keychain, installs Apple WWDR certificates)
    setup_ci

    # 2. Install Manual Certificate & Profile
    import_certificate(
      certificate_path: File.expand_path("../certs/ios_distribution.p12", __dir__),
      certificate_password: "Apple123!",
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # Forcefully allow codesign to access the private key
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k \"\" ~/Library/Keychains/fastlane_tmp_keychain-db")

    install_provisioning_profile(
      path: File.expand_path("../certs/EtasEt_AppStore_Profile.mobileprovision", __dir__)
    )

    # 3. Build IPA
    build_app(
      project: File.expand_path("../dars-ios.xcodeproj", __dir__),
      scheme: "dars-ios",
      export_method: "app-store",
      clean: true,
      output_name: "dars-ios.ipa",
      xcargs: "OTHER_CODE_SIGN_FLAGS=\"--keychain ~/Library/Keychains/fastlane_tmp_keychain-db\" CURRENT_PROJECT_VERSION=#{ENV['GITHUB_RUN_NUMBER'] || '100'}",
      export_options: {
        signingStyle: "manual",
        teamID: "WGARWL7QZ4",
        provisioningProfiles: {
          "com.amasyaetas.mobile" => "EtasEt_AppStore_Profile"
        }
      }
    )

    # 4. Upload to Apple TestFlight via xcrun altool with specific ASC Provider
    ipa_path = File.expand_path("../dars-ios.ipa", __dir__)
    user = ENV['FASTLANE_USER']
    password = ENV['FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD']

    UI.message("Fetching App Store Connect providers for #{user}...")
    providers_raw = `xcrun altool --list-providers -u "#{user}" -p "#{password}" 2>&1`
    UI.message("Available Providers:\n#{providers_raw}")

    # Identify the target provider shortname or team ID
    target_provider = "WGARWL7QZ4"
    providers_raw.each_line do |line|
      # Look for line matching our team or account
      if line.include?("WGARWL7QZ4") || line.include?("6025c9a1") || line.downcase.include?("etas") || line.downcase.include?("amasya")
        parts = line.strip.split(/\s{2,}|\t+/)
        if parts.length >= 2 && !parts[1].empty?
          target_provider = parts[1].strip
          UI.message("Selected matching provider shortname: #{target_provider}")
        end
      end
    end

    UI.message("Uploading #{ipa_path} to Apple TestFlight via xcrun altool --upload-app...")
    upload_cmd = "xcrun altool --upload-app -f \"#{ipa_path}\" -t ios -u \"#{user}\" -p \"#{password}\" --asc-provider \"#{target_provider}\" --verbose"
    sh(upload_cmd)
  end
end
