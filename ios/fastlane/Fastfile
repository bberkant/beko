default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to Apple TestFlight automatically"
  lane :beta do
    # 1. Setup CI (Creates temporary keychain, installs Apple WWDR certificates)
    setup_ci

    # 2. Install Manual Certificate & Profile
    import_certificate(
      certificate_path: File.expand_path("../certs/ios_distribution.p12", __dir__),
      certificate_password: "Apple123!",
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # Forcefully allow codesign to access the private key
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k \"\" ~/Library/Keychains/fastlane_tmp_keychain-db")

    install_provisioning_profile(
      path: File.expand_path("../certs/EtasEt_AppStore_Profile.mobileprovision", __dir__)
    )



    # 4. Build IPA
    build_app(
      project: File.expand_path("../dars-ios.xcodeproj", __dir__),
      scheme: "dars-ios",
      export_method: "app-store",
      clean: true,
      output_name: "dars-ios.ipa",
      xcargs: "OTHER_CODE_SIGN_FLAGS=\"--keychain ~/Library/Keychains/fastlane_tmp_keychain-db\" CURRENT_PROJECT_VERSION=#{ENV['GITHUB_RUN_NUMBER'] || '100'}",
      export_options: {
        signingStyle: "manual",
        teamID: "WGARWL7QZ4",
        provisioningProfiles: {
          "com.amasyaetas.mobile" => "EtasEt_AppStore_Profile"
        }
      }
    )

    # 5. Upload directly to Apple TestFlight using Fastlane Transporter (Supports App-Specific Passwords)
    upload_to_testflight(
      ipa: File.expand_path("../dars-ios.ipa", __dir__),
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end

