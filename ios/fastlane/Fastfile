default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to Apple TestFlight automatically"
  lane :beta do
    key_path = File.expand_path("./AuthKey_T7BGJ39HPK.p8", __dir__)
    unless File.exist?(key_path)
      key_path = File.expand_path("../AuthKey_T7BGJ39HPK.p8", __dir__)
    end

    api_key = app_store_connect_api_key(
      key_id: "T7BGJ39HPK",
      issuer_id: "6025c8a1-87c2-474e-aa8d-8b6b07a6d268",
      key_filepath: key_path,
      in_house: false
    )

    # 1. Create temporary keychain for CI code signing
    keychain_name = "fastlane_tmp_keychain"
    keychain_password = "temporary_ci_password_123"
    
    begin
      delete_keychain(name: keychain_name)
    rescue => e
    end

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # 2. Fetch or create Distribution Certificate & Profile via Apple REST API
    get_certificates(
      api_key: api_key,
      development: false
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.amasyaetas.mobile",
      development: false
    )

    # 3. Generate Xcode Project
    sh("xcodegen generate")

    # 4. Build IPA
    build_app(
      project: "MarifEt.xcodeproj",
      scheme: "MarifEt",
      export_method: "app-store",
      clean: true,
      export_options: {
        signingStyle: "automatic",
        teamID: "WGARWL7QZ4"
      }
    )

    # 5. Upload directly to Apple TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
